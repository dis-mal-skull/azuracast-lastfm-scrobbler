# URL base de tu instalacion AzuraCast, SIN barra final.
AZURACAST_URL=https://tu-radio.example.com

# Shortcode (o id numerico) de tu emisora.
# Deja vacio para autodetectarla si tu AzuraCast tiene una sola emisora.
# Para averiguarlo ejecuta:  npm run diagnose
STATION_SHORTCODE=

# Credenciales de tu API de Last.fm. Creala en:
# https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Se rellena automaticamente al ejecutar:  npm run auth
LASTFM_SESSION_KEY=

# Cada cuantos segundos consultar la emisora.
POLL_INTERVAL_SECONDS=15

# true  = envia "now playing" y scrobbles a Last.fm
# false = solo muestra por consola lo que suena (modo prueba)
SCROBBLE_ENABLED=true

# true  = cada tema se scrobbea una sola vez (omite repetidos)
# false = scrobbea TODAS las reproducciones, incluidas repetidas
SCROBBLE_UNIQUE=false

# Nivel de log: info | debug
LOG_LEVEL=info
